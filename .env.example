# ─────────────────────────────────────────────
#  SnapShot AI — Environment Variables
#  Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Your deployed URL (use http://localhost:3000 for dev)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ── STRIPE ───────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# For testing, use sk_test_... and whsec_test_...

# ── REPLICATE ────────────────────────────────
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# ── RESEND (email delivery) ───────────────────
# Sign up free at https://resend.com — 3000 emails/month free
# Also verify your sending domain in Resend dashboard
RESEND_API_KEY=re_...
